<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ system splash icon.
     The system scales this drawable to fill the icon area and masks it to a
     circle. An <inset> with percentage insets guarantees the The Cat logo
     always occupies only the inner ~52% of whatever bounds the system uses, so
     the hexagon stays inside the circle with padding and is never clipped —
     unlike a layer-list, whose intrinsic size the splash system ignores. -->
<inset xmlns:android="http://schemas.android.com/apk/res/android"
    android:drawable="@drawable/server_thecat"
    android:insetLeft="24%"
    android:insetTop="24%"
    android:insetRight="24%"
    android:insetBottom="24%" />
